generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id             String           @id @default(uuid()) @db.Uuid
  code           String           @unique
  nameAr         String           @map("name_ar")
  nameEn         String?          @map("name_en")
  addressAr      String?          @map("address_ar")
  addressEn      String?          @map("address_en")
  latitude       Decimal?         @db.Decimal(10, 7)
  longitude      Decimal?         @db.Decimal(10, 7)
  phone          String?
  imageUrl       String?          @map("image_url")
  timezone       String           @default("Asia/Dubai")
  prepTimeMin    Int              @default(10) @map("prep_time_min")
  prepTimeMax    Int              @default(20) @map("prep_time_max")
  isActive       Boolean          @default(true) @map("is_active")
  isOpenOverride Boolean?         @map("is_open_override")
  acceptsOrders  Boolean          @default(true) @map("accepts_orders")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  hours           BranchHour[]
  specialHours    BranchSpecialHour[]
  branchProducts  BranchProduct[]
  branchModifiers BranchModifier[]
  orders          Order[]
  @@map("branches")
}

model BranchHour {
  id String @id @default(uuid()) @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  dayOfWeek Int @map("day_of_week")
  opensAt String? @map("opens_at")
  closesAt String? @map("closes_at")
  isClosed Boolean @default(false) @map("is_closed")
  branch Branch @relation(fields:[branchId],references:[id],onDelete:Cascade)
  @@unique([branchId,dayOfWeek])
  @@map("branch_hours")
}

model BranchSpecialHour {
  id String @id @default(uuid()) @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  localDate DateTime @map("local_date") @db.Date
  opensAt String? @map("opens_at")
  closesAt String? @map("closes_at")
  isClosed Boolean @default(false) @map("is_closed")
  note String?
  branch Branch @relation(fields:[branchId],references:[id],onDelete:Cascade)
  @@unique([branchId,localDate])
  @@map("branch_special_hours")
}

model Category {
  id String @id @default(uuid()) @db.Uuid
  nameAr String @map("name_ar")
  nameEn String? @map("name_en")
  imageUrl String? @map("image_url")
  sortOrder Int @default(0) @map("sort_order")
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  products Product[]
  @@map("categories")
}

model Product {
  id String @id @default(uuid()) @db.Uuid
  categoryId String? @map("category_id") @db.Uuid
  sku String @unique
  nameAr String @map("name_ar")
  nameEn String? @map("name_en")
  descriptionAr String? @map("description_ar")
  descriptionEn String? @map("description_en")
  imageUrl String? @map("image_url")
  basePrice Decimal @map("base_price") @db.Decimal(12,2)
  isActive Boolean @default(true) @map("is_active")
  sortOrder Int @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  category Category? @relation(fields:[categoryId],references:[id])
  branchProducts BranchProduct[]
  modifierGroups ModifierGroup[]
  orderItems OrderItem[]
  @@map("products")
}

model BranchProduct {
  branchId String @map("branch_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  priceOverride Decimal? @map("price_override") @db.Decimal(12,2)
  isAvailable Boolean @default(true) @map("is_available")
  soldOutReason String? @map("sold_out_reason")
  updatedAt DateTime @updatedAt @map("updated_at")
  branch Branch @relation(fields:[branchId],references:[id],onDelete:Cascade)
  product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  @@id([branchId,productId])
  @@map("branch_products")
}

model ModifierGroup {
  id String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid
  nameAr String @map("name_ar")
  nameEn String? @map("name_en")
  selectionType String @default("SINGLE") @map("selection_type")
  minSelect Int @default(0) @map("min_select")
  maxSelect Int? @map("max_select")
  sortOrder Int @default(0) @map("sort_order")
  isRequired Boolean @default(false) @map("is_required")
  isActive Boolean @default(true) @map("is_active")
  product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  modifiers Modifier[]
  @@map("modifier_groups")
}

model Modifier {
  id String @id @default(uuid()) @db.Uuid
  modifierGroupId String @map("modifier_group_id") @db.Uuid
  nameAr String @map("name_ar")
  nameEn String? @map("name_en")
  priceDelta Decimal @default(0) @map("price_delta") @db.Decimal(12,2)
  isActive Boolean @default(true) @map("is_active")
  sortOrder Int @default(0) @map("sort_order")
  modifierGroup ModifierGroup @relation(fields:[modifierGroupId],references:[id],onDelete:Cascade)
  branchModifiers BranchModifier[]
  @@map("modifiers")
}

model BranchModifier {
  branchId String @map("branch_id") @db.Uuid
  modifierId String @map("modifier_id") @db.Uuid
  priceDeltaOverride Decimal? @map("price_delta_override") @db.Decimal(12,2)
  isAvailable Boolean @default(true) @map("is_available")
  branch Branch @relation(fields:[branchId],references:[id],onDelete:Cascade)
  modifier Modifier @relation(fields:[modifierId],references:[id],onDelete:Cascade)
  @@id([branchId,modifierId])
  @@map("branch_modifiers")
}

model Customer {
  id String @id @default(uuid()) @db.Uuid
  phone String? @unique
  email String? @unique
  fullName String? @map("full_name")
  preferredLanguage String @default("ar") @map("preferred_language")
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  orders Order[]
  @@map("customers")
}

model AdminUser {
  id String @id @default(uuid()) @db.Uuid
  username String @unique
  passwordHash String @map("password_hash")
  role String @default("OWNER")
  isActive Boolean @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("admin_users")
}

model Promotion {
  id String @id @default(uuid()) @db.Uuid
  name String
  code String? @unique
  type String
  value Decimal @default(0) @db.Decimal(12,2)
  scope String @default("ALL")
  targetId String? @map("target_id")
  branchIds String[] @default([]) @map("branch_ids")
  startsAt DateTime? @map("starts_at")
  endsAt DateTime? @map("ends_at")
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("promotions")
}

model AppSetting {
  key String @id
  value String
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("app_settings")
}

model Order {
  id String @id @default(uuid()) @db.Uuid
  orderNumber String @unique @map("order_number")
  idempotencyKey String? @map("idempotency_key")
  customerId String? @map("customer_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  status String @default("PAYMENT_PENDING")
  pickupMethod String @default("WALK_IN") @map("pickup_method")
  currency String @default("AED")
  subtotal Decimal @db.Decimal(12,2)
  discountTotal Decimal @default(0) @map("discount_total") @db.Decimal(12,2)
  taxTotal Decimal @default(0) @map("tax_total") @db.Decimal(12,2)
  total Decimal @db.Decimal(12,2)
  note String?
  vehiclePlate String? @map("vehicle_plate")
  vehicleEmirate String? @map("vehicle_emirate")
  vehicleMakeModel String? @map("vehicle_make_model")
  vehicleColor String? @map("vehicle_color")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  customer Customer? @relation(fields:[customerId],references:[id])
  branch Branch @relation(fields:[branchId],references:[id])
  items OrderItem[]
  statusHistory OrderStatusHistory[]
  outboxEvents OutboxEvent[]
  @@index([idempotencyKey])
  @@index([createdAt])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id String @id @default(uuid()) @db.Uuid
  orderId String @map("order_id") @db.Uuid
  productId String? @map("product_id") @db.Uuid
  productName String @map("product_name")
  quantity Int @default(1)
  unitPrice Decimal @map("unit_price") @db.Decimal(12,2)
  lineTotal Decimal @map("line_total") @db.Decimal(12,2)
  modifiersJson Json? @map("modifiers_json")
  note String?
  order Order @relation(fields:[orderId],references:[id],onDelete:Cascade)
  product Product? @relation(fields:[productId],references:[id])
  @@map("order_items")
}

model OrderStatusHistory {
  id String @id @default(uuid()) @db.Uuid
  orderId String @map("order_id") @db.Uuid
  status String
  note String?
  createdAt DateTime @default(now()) @map("created_at")
  order Order @relation(fields:[orderId],references:[id],onDelete:Cascade)
  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model OutboxEvent {
  id String @id @default(uuid()) @db.Uuid
  orderId String? @map("order_id") @db.Uuid
  eventType String @map("event_type")
  payload Json
  processedAt DateTime? @map("processed_at")
  createdAt DateTime @default(now()) @map("created_at")
  order Order? @relation(fields:[orderId],references:[id],onDelete:Cascade)
  @@index([processedAt, createdAt])
  @@map("outbox_events")
}
