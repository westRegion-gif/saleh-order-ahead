# ---------------------------------------------------------------------------
# NOX Raid Analyst - environment configuration
# Copy to .env.local and fill in. NEVER commit .env / .env.local.
# ---------------------------------------------------------------------------

# Warcraft Logs API v2 (REQUIRED for live data)
# Create a client at: https://www.warcraftlogs.com/api/clients/
# These stay server-side only and are never exposed to the browser.
WARCRAFTLOGS_CLIENT_ID=
WARCRAFTLOGS_CLIENT_SECRET=

# OpenAI (OPTIONAL - enables the AI Coach layer)
# Without this the deterministic analysis engine still works fully.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: expose the developer diagnostics panel in Settings (true/false)
NOX_DEV_MODE=false
